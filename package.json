{
  "name": "cecreh-manuscripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CECREH manuscript register with reviewed public metadata and separate synthetic test fixtures.",
  "scripts": {
    "schema": "node scripts/compile-schema.mjs",
    "validate": "node scripts/validate.mjs data/manuscripts.json",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --root dist/demo --port 4173",
    "check": "npm run schema && npm run validate && npm run validate:public && npm test && npm run build && npm run build:public && npm run test:ui",
    "validate:public": "node scripts/validate.mjs data/public-manuscripts.json",
    "build:public": "node scripts/build.mjs --public",
    "preview:public": "node scripts/serve.mjs --root dist/public --port 4173"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.12"
  }
}
